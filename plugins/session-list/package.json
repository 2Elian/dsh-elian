{
  "name": "@2elian/dsh-client-ui-session-list",
  "version": "0.1.0",
  "description": "User-turn outline for the DeepSeek Harness Web client: lists every prompt of the conversation and jumps the transcript to the turn that sent it.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2Elian/dsh-elian.git",
    "directory": "plugins/session-list"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node build.mjs"
  },
  "devDependencies": {
    "@2elian/dsh-session-delta-search": "workspace:^",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
